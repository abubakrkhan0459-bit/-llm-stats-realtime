        padding: 40px 20px;
        background: var(--surface);
        min-height: 100vh;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        background: var(--card-bg);
        padding: 40px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    h1 {
        color: var(--primary);
        margin-bottom: 10px;
        font-size: 2.5rem;
    }

    .last-updated {
        color: var(--text-secondary);
        font-style: italic;
        margin-bottom: 30px;
    }

    section {
        margin-bottom: 30px;
    }

    h2 {
        color: var(--accent);
        margin-top: 30px;
        margin-bottom: 15px;
        font-size: 1.5rem;
    }

    h3 {
        color: var(--text-primary);
        margin-top: 20px;
        margin-bottom: 10px;
        font-size: 1.2rem;
    }

    h4 {
        color: var(--text-secondary);
        margin-top: 15px;
        margin-bottom: 10px;
        font-size: 1.1rem;
    }

    p {
        line-height: 1.6;
        margin-bottom: 15px;
        color: var(--text-primary);
    }

    ul {
        margin-bottom: 15px;
        padding-left: 20px;
    }

    li {
        margin-bottom: 8px;
        line-height: 1.5;
    }

    a {
        color: var(--primary);
        text-decoration: underline;
    }

    a:hover {
        color: var(--accent);
    }

    .legal-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        text-align: center;
    }

    .legal-footer a {
        margin: 0 10px;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        // Scroll to top when page loads
        JSRuntime.InvokeVoidAsync("scrollTo", 0, 0);
    }
}
