@* SEO Component for Dynamic Meta Tags and Page Titles *@
@* Usage: <SEO MetaTitle="..." MetaDescription="..." /> *@

@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavigationManager

<PageTitle>@(string.IsNullOrEmpty(MetaTitle) ? "LLM Stats Realtime" : MetaTitle)</PageTitle>

<HeadContent>
    @* Meta Description *@
    @if (!string.IsNullOrEmpty(MetaDescription))
    {
        <meta name="description" content="@MetaDescription" />
    }
    
    @* Keywords *@
    @if (!string.IsNullOrEmpty(MetaKeywords))
    {
        <meta name="keywords" content="@MetaKeywords" />
    }
    
    @* Canonical URL *@
    @if (!string.IsNullOrEmpty(CanonicalUrl))
    {
        <link rel="canonical" href="@CanonicalUrl" />
    }
    else
    {
        <link rel="canonical" href="@NavigationManager.Uri" />
    }
    
    @* Robots *@
    @if (!string.IsNullOrEmpty(Robots))
    {
        <meta name="robots" content="@Robots" />
    }
    
    @* Author *@
    @if (!string.IsNullOrEmpty(Author))
    {
        <meta name="author" content="@Author" />
    }
    
    @* Open Graph Tags *@
    @if (EnableOpenGraph)
    {
        <meta property="og:title" content="@(string.IsNullOrEmpty(OgTitle) ? MetaTitle : OgTitle)" />
        <meta property="og:description" content="@(string.IsNullOrEmpty(OgDescription) ? MetaDescription : OgDescription)" />
        <meta property="og:type" content="@OgType" />
        <meta property="og:url" content="@(string.IsNullOrEmpty(OgUrl) ? NavigationManager.Uri : OgUrl)" />
        
        @if (!string.IsNullOrEmpty(OgImage))
        {
            <meta property="og:image" content="@OgImage" />
        }
        
        @if (!string.IsNullOrEmpty(OgImageWidth))
        {
            <meta property="og:image:width" content="@OgImageWidth" />
        }
        
        @if (!string.IsNullOrEmpty(OgImageHeight))
        {
            <meta property="og:image:height" content="@OgImageHeight" />
        }
        
        @if (!string.IsNullOrEmpty(OgSiteName))
        {
            <meta property="og:site_name" content="@OgSiteName" />
        }
    }
    
    @* Twitter Card *@
    @if (EnableTwitterCard)
    {
        <meta name="twitter:card" content="@TwitterCard" />
        <meta name="twitter:title" content="@(string.IsNullOrEmpty(TwitterTitle) ? MetaTitle : TwitterTitle)" />
        <meta name="twitter:description" content="@(string.IsNullOrEmpty(TwitterDescription) ? MetaDescription : TwitterDescription)" />
        
        @if (!string.IsNullOrEmpty(TwitterImage))
        {
            <meta name="twitter:image" content="@TwitterImage" />
        }
        
        @if (!string.IsNullOrEmpty(TwitterSite))
        {
            <meta name="twitter:site" content="@TwitterSite" />
        }
    }
    
    @* Structured Data / JSON-LD *@
    @if (!string.IsNullOrEmpty(StructuredData))
    {
        <script type="application/ld+json">
            @StructuredData
        </script>
    }
</HeadContent>

@code {
    [Parameter]
    public string? MetaTitle { get; set; }

    [Parameter]
    public string? MetaDescription { get; set; }

    [Parameter]
    public string? MetaKeywords { get; set; }

    [Parameter]
    public string? CanonicalUrl { get; set; }

    [Parameter]
    public string? Robots { get; set; } = "index, follow";

    [Parameter]
    public string? Author { get; set; } = "LLM Stats Realtime";

    [Parameter]
    public bool EnableOpenGraph { get; set; } = true;

    [Parameter]
    public string? OgTitle { get; set; }

    [Parameter]
    public string? OgDescription { get; set; }

    [Parameter]
    public string OgType { get; set; } = "website";

    [Parameter]
    public string? OgUrl { get; set; }

    [Parameter]
    public string? OgImage { get; set; }

    [Parameter]
    public string? OgImageWidth { get; set; } = "1200";

    [Parameter]
    public string? OgImageHeight { get; set; } = "630";

    [Parameter]
    public string? OgSiteName { get; set; } = "LLM Stats Realtime";

    [Parameter]
    public bool EnableTwitterCard { get; set; } = true;

    [Parameter]
    public string TwitterCard { get; set; } = "summary_large_image";

    [Parameter]
    public string? TwitterTitle { get; set; }

    [Parameter]
    public string? TwitterDescription { get; set; }

    [Parameter]
    public string? TwitterImage { get; set; }

    [Parameter]
    public string? TwitterSite { get; set; }

    [Parameter]
    public string? StructuredData { get; set; }
}
