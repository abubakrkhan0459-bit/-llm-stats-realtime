 <footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-brand">
                <div class="footer-logo">
                    <div class="logo-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                        </svg>
                    </div>
                    <div class="footer-logo-text">
                        <span class="footer-logo-main">LLM Stats</span>
                        <span class="footer-logo-sub">Realtime</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 LLM Stats Realtime. All benchmarks and metrics are for informational purposes.</p>
        </div>
    </div>
</footer>